	partition Alerts = m
		mode: import
		source =
				let
				    FileContent = File.Contents("C:\Users\ACER\Downloads\Seminar_Cloud\alerts.json"),
				    Lines = Lines.FromBinary(FileContent),
				    NonEmpty = List.Select(Lines, each Text.Trim(_) <> ""),
				    Records = List.Transform(NonEmpty, each Json.Document(_)),
				    Result = Table.FromRecords(Records),
				    #"Changed Type" = Table.TransformColumnTypes(Result,{{"MachineId", type text}, {"ProductionLine", type text}, {"SensorType", type text}, {"SensorUnit", type text}, {"WindowStartTime", type datetimezone}, {"ReadingCount", Int64.Type}, {"MinValue", type number}, {"AvgValue", type number}, {"MaxValue", type number}, {"LowerThreshold", type number}, {"UpperThreshold", type number}, {"LowCount", Int64.Type}, {"HighCount", Int64.Type}, {"SourceAnomalyCount", Int64.Type}, {"AlertTriggerTime", type datetimezone}, {"OutOfRangeCount", Int64.Type}, {"AlertDirection", type text}, {"Severity", type text}, {"ErrorDescription", type text}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

