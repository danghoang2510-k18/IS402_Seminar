table Alerts
	lineageTag: 7c1d3dd5-f5ee-451a-8aa0-89a153badc36

	measure 'Total Readings' =
			
			SUM(Trends[ReadingCount])
		formatString: 0
		lineageTag: 5cf0fc9c-2915-4ea4-94c1-304b09084378

	measure 'Alert Records' =
			
			COUNTROWS(Alerts)
		formatString: 0
		lineageTag: 7e30333d-eb95-4be7-9b4d-d500a94b37be

	measure 'Critical Alerts' =
			
			CALCULATE(
			    COUNTROWS(Alerts),
			    Alerts[Severity] = "Critical"
			)
		formatString: 0
		lineageTag: 81a6118e-53c9-48c5-ab04-966e4d97a061

	measure 'Warning Alerts' =
			
			CALCULATE(
			    COUNTROWS(Alerts),
			    Alerts[Severity] = "Warning"
			)
		formatString: 0
		lineageTag: 40eb0d4a-877f-452c-9325-5d997e31e3eb

	measure 'Critical Rate' =
			
			DIVIDE([Critical Alerts], [Alert Records], 0)
		lineageTag: 74ae9413-f8ae-496e-9cc4-467f4ef3276d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Violation Rate' =
			
			DIVIDE(
			    SUM(Alerts[OutOfRangeCount]),
			    SUM(Alerts[ReadingCount]),
			    0
			)
		lineageTag: 50fe09e1-aaab-4a34-a336-af1c85b58f3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

