table Trends
	lineageTag: 2ae7e02a-1f95-411f-be02-5c6d11402675

	measure 'Total Machines' =
			
			DISTINCTCOUNT(Trends[MachineId])
		formatString: 0
		lineageTag: e6e4b654-eee0-4854-949c-7b9d8b2f5a42

	measure 'Avg Sensor Value' =
			
			DIVIDE(
			    SUMX(
			        Trends,
			        Trends[AvgValue] * Trends[ReadingCount]
			    ),
			    SUM(Trends[ReadingCount])
			)
		lineageTag: fe31d9ac-f39e-47a4-9bfb-9c959dd2a70a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min Sensor Value' =
			
			MIN(Trends[MinValue])
		lineageTag: 5beae41f-bef3-4abc-aaa9-858c9bdb77fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Sensor Value' =
			
			MAX(Trends[MaxValue])
		lineageTag: 0706638e-1dca-4247-aa03-42ae71c36500

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Readings Below' =
			
			SUM(Trends[LowCount])
		formatString: 0
		lineageTag: aafec9e6-6bc4-4cdc-ac9b-0baa988080ba

	measure 'Readings Above' =
			
			SUM(Trends[HighCount])
		formatString: 0
		lineageTag: e6c73855-181c-4143-9d92-38d2a5fffddc

	measure 'Out of Range Readings' =
			
			[Readings Below] + [Readings Above]
		formatString: 0
		lineageTag: a8a176a2-2fa6-41ca-95c8-31f40a741575

	measure 'Sensor Violation Rate' =
			
			DIVIDE(
			    [Out of Range Readings],
			    SUM(Trends[ReadingCount]),
			    0
			)
		lineageTag: e4e23d2e-1bc8-4360-a252-2fbcbe506cca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lower Sensor Threshold' =
			
			SELECTEDVALUE(Trends[LowerThreshold])
		lineageTag: 598d99a1-ff27-4b75-8903-8e463fd899fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Upper Sensor Threshold' =
			
			SELECTEDVALUE(Trends[UpperThreshold])
		lineageTag: 8671cbf1-c3d9-4663-81b7-f8dc99e5545b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Sensor Unit' =
			
			SELECTEDVALUE(Trends[SensorUnit], "Select a sensor")
		lineageTag: 73443081-a787-4acb-b2d7-1b73e28f2514

