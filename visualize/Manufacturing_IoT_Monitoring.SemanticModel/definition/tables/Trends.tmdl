	partition Trends = m
		mode: import
		source =
				let
				    FileContent = File.Contents("C:\Users\ACER\Downloads\Seminar_Cloud\trends.json"),
				    Lines = Lines.FromBinary(FileContent),
				    NonEmpty = List.Select(Lines, each Text.Trim(_) <> ""),
				    Records = List.Transform(NonEmpty, each Json.Document(_)),
				    Result = Table.FromRecords(Records),
				    #"Changed Type" = Table.TransformColumnTypes(Result,{{"MachineId", type text}, {"ProductionLine", type text}, {"SensorType", type text}, {"SensorUnit", type text}, {"WindowStartTime", type datetimezone}, {"ReadingCount", Int64.Type}, {"MinValue", type number}, {"AvgValue", type number}, {"MaxValue", type number}, {"LowerThreshold", type number}, {"UpperThreshold", type number}, {"LowCount", Int64.Type}, {"HighCount", Int64.Type}, {"SourceAnomalyCount", Int64.Type}, {"WindowEndTime", type datetimezone}})
				in
				    #"Changed Type"

